      "value": "-70.66"
    },
    {
      "key": "opensky_client_id",
      "value": ""
    },
    {
      "key": "opensky_client_secret",
      "value": ""
    },
    {
      "key": "opensky_token",
      "value": ""
    },
    {
      "key": "opentopography_key",
      "value": ""
    },
    {
      "key": "openweather_key",
      "value": ""
    },
    {
      "key": "opencellid_key",
      "value": ""
    },
    {
      "key": "gpsjam_date",
      "value": "2026-09-02"
    },
    {
      "key": "acled_email",
      "value": ""
