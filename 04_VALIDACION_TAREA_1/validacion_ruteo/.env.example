# Credenciales locales para PostgreSQL/PostGIS.
# Copia este archivo como .env y reemplaza los valores marcados.
POSTGRES_DB=ruteo_uav
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_ESTA_PASSWORD
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:CAMBIAR_ESTA_PASSWORD@localhost:5432/ruteo_uav

# Parametros del area de trabajo y fuentes externas.
BBOX_S=-33.60
BBOX_W=-70.80
BBOX_N=-33.30
BBOX_E=-70.50
GPSJAM_DATE=2026-09-03
OPENAIP_COUNTRY=CL
ACLED_COUNTRY=Chile
ACLED_DATE_FROM=2026-01-01
ACLED_DATE_TO=2026-09-03

# Claves externas. Mantener vacias hasta obtener credenciales reales.
OPENAIP_API_KEY=
OPENTOPOGRAPHY_API_KEY=
OPENWEATHER_API_KEY=
OPENCELLID_API_KEY=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
ACLED_USERNAME=
ACLED_PASSWORD=
