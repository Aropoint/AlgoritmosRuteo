# Tarea 2. Opcional: copia este archivo como .env (no se sube al repo) para cambiar valores.
# Sin .env, docker compose usa estos mismos valores y la contraseña local "ruteo_uav_local";
# la BD solo es accesible desde la red interna de Docker.
POSTGRES_DB=ruteo_uav
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CAMBIAR_ESTA_PASSWORD
WEB_PORT=8000

# Qué hace main.py al correr docker compose up (1 = sí):
# SIN_DESCARGA reutiliza los JSON ya generados; SOLO_SITIO no corre el pipeline.
SIN_DESCARGA=0
SOLO_SITIO=0

# Ventana temporal de las fuentes (fechas fijas para que la descarga sea reproducible).
# Período histórico [INICIO_HISTORICO, FECHA_CORTE]: alimenta los pesos de riesgo.
# Incendios en (FECHA_CORTE, FECHA_CORTE + DIAS_EVALUACION]: focos de las fallas simuladas.
# GPSJam y viento: los VENTANA_DIAS días que terminan en FECHA_CORTE.
FECHA_CORTE=2024-12-31
INICIO_HISTORICO=2022-02-24
VENTANA_DIAS=30
DIAS_EVALUACION=180
BUFFER_KM=5
