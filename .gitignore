# Entornos y archivos locales de Python
/venv/
**/.venv/
**/__pycache__/
*.py[cod]
**/.pytest_cache/

# Credenciales: nunca subir valores locales
**/.env
**/.env.*
!**/.env.example
**/credentials.json
**/Credentials/
*.pem
*.p12

